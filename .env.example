# --- Обязательные ---
DATABASE_URL=postgresql://nestro:CHANGE_ME@localhost:5432/nestro?schema=public
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=
INVITATION_SECRET=
APP_URL=http://localhost:3000

# --- LLM (опционально; при none система работает в режиме ASSESSMENT_PENDING) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_PRIMARY=
LLM_MODEL_SECONDARY=
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3

# --- Object storage (опционально; иначе локальный том ./storage) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMTP (опционально) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Прочее ---
RETENTION_MONTHS=24
LOG_LEVEL=info
NODE_ENV=development
